#!/bin/bash
#SBATCH --partition=gpu_a100
#SBATCH --gres=gpu:1
#SBATCH --gpus=1
#SBATCH --cpus-per-task=8
#SBATCH --job-name=cv2_refix
#SBATCH --ntasks=1
#SBATCH --time=01:30:00
#SBATCH --mem=64000M
#SBATCH --output=outfiles/refix_%A.out

# Re-run sensitivity (PUP3DGS-faithful 6x6 Fisher) and visibility (4DGS-W
# uncertainty = 1 - sigmoid(C_k)) on an existing trained model. Then re-render
# their 2D sigma maps for calib + test. No retraining.

set -eu

OUT="${OUT:-output/train_30k}"

module purge
module load 2024
module load Anaconda3/2024.06-1

if [[ -n "${SLURM_SUBMIT_DIR:-}" ]]; then
    REPO_ROOT="${SLURM_SUBMIT_DIR}"
else
    REPO_ROOT="$(realpath "$(dirname "${BASH_SOURCE[0]}")/..")"
fi
cd "${REPO_ROOT}"

source activate gaussian_splatting
module load 2023
module load CUDA/12.1.1
export TORCH_CUDA_ARCH_LIST="8.0"

SPLIT_DIR="$OUT/splits"

echo "[1/4] Re-computing PUP3DGS-faithful Fisher sensitivity"
python scripts/compute_sensitivity.py -m "$OUT"

echo "[2/4] Re-rendering sensitivity 2D sigma maps"
python scripts/render_per_gaussian_scalar.py \
    -m "$OUT" --split_dir "$SPLIT_DIR" --skip_train \
    --modality sensitivity \
    --scores_path "$OUT/uncertainty/fishers.npz" \
    --score_key fishers_log_dets \
    --score_transform shift_positive

echo "[3/4] Re-computing visibility (with paper-faithful uncertainty key)"
python scripts/compute_visibility.py -m "$OUT"

echo "[4/4] Re-rendering visibility 2D sigma maps using uncertainty = 1 - sigmoid(C_k)"
python scripts/render_per_gaussian_scalar.py \
    -m "$OUT" --split_dir "$SPLIT_DIR" --skip_train \
    --modality visibility \
    --scores_path "$OUT/uncertainty/visibility.npz" \
    --score_key uncertainty

echo "[done]"
